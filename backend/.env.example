# ===================== SERVEUR =====================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# ===================== BASE DE DONNEES (Neon PostgreSQL) =====================
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/library_db?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.neon.tech/library_db?sslmode=require"

# ===================== JWT =====================
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===================== COOKIES =====================
COOKIE_SECRET=change_this_cookie_secret_in_production

# ===================== SECURITE =====================
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ===================== EMAIL (Nodemailer) =====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM="Bibliothèque <no-reply@library.com>"

# ===================== CLOUDINARY (Stockage images) =====================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===================== PARAMETRES METIER =====================
DEFAULT_BORROW_DURATION_DAYS=14
DEFAULT_MAX_BORROWS_PER_USER=3
DEFAULT_FINE_PER_DAY=100
RESERVATION_EXPIRY_HOURS=48
