# URL de base de l'API backend. En développement, le proxy Vite (vite.config.ts)
# redirige déjà /api vers http://localhost:5000, cette variable est surtout utile
# pour un déploiement où le frontend (Vercel) et le backend (Render) sont sur des domaines distincts.
VITE_API_URL=http://localhost:5000/api/v1
